@echo off
REM Скрипт для загрузки клона при следующем перезапуске
REM Разместить в C:\BootManager\boot-to-clone.bat

echo ========================================
echo Настройка загрузки КЛОНА при следующем перезапуске
echo ========================================

bcdedit /bootsequence {830100c2-c752-11f0-88b8-d843ae6dfa0a}

if %errorlevel% equ 0 (
    echo.
    echo [OK] Клон будет загружен при следующем перезапуске
    echo [OK] После перезапуска система вернется к основной загрузке по умолчанию
    echo.
    echo Для перезапуска выполните: shutdown /r /t 10
) else (
    echo.
    echo [ОШИБКА] Не удалось настроить загрузку клона
)

pause

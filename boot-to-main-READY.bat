@echo off
REM Скрипт для загрузки основной системы при следующем перезапуске
REM Разместить в C:\BootManager\boot-to-main.bat

echo ========================================
echo Настройка загрузки ОСНОВНОЙ СИСТЕМЫ при следующем перезапуске
echo ========================================

bcdedit /bootsequence {current}

if %errorlevel% equ 0 (
    echo.
    echo [OK] Основная система будет загружена при следующем перезапуске
    echo.
    echo Для перезапуска выполните: shutdown /r /t 10
) else (
    echo.
    echo [ОШИБКА] Не удалось настроить загрузку
)

pause

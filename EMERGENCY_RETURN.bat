@echo off
REM АВАРИЙНЫЙ ВОЗВРАТ К ОСНОВНОЙ СИСТЕМЕ
REM Этот скрипт размещается В КЛОНЕ для экстренного возврата к основной системе
REM Разместить в клоне: D:\EMERGENCY_RETURN.bat (когда VHDX смонтирован)
REM После загрузки клона будет доступен как C:\EMERGENCY_RETURN.bat

echo ========================================
echo АВАРИЙНЫЙ ВОЗВРАТ К ОСНОВНОЙ СИСТЕМЕ
echo ========================================
echo.
echo Этот скрипт вернет загрузку к основной системе
echo и немедленно перезапустит сервер
echo.
echo ВНИМАНИЕ! Перезапуск через 10 секунд...
echo.

REM ЗАМЕНИТЕ {GUID_ОСНОВНОЙ_СИСТЕМЫ} на реальный GUID
bcdedit /bootsequence {GUID_ОСНОВНОЙ_СИСТЕМЫ}

if %errorlevel% equ 0 (
    echo [OK] Возврат к основной системе настроен
    shutdown /r /t 10 /c "АВАРИЙНЫЙ ВОЗВРАТ К ОСНОВНОЙ СИСТЕМЕ"
) else (
    echo [ОШИБКА] Не удалось настроить возврат
    echo Попробуйте вручную: bcdedit /bootsequence {GUID}
    pause
)
